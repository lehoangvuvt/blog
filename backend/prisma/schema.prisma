// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  password     String
  slug         String  @unique
  full_name    String? @db.VarChar(50)
  avatar       String?
  introduction String? @db.VarChar(200)
  is_active    Boolean @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  posts        Post[]
  postComments PostComments[]
  postLikes    PostLikes[]
  postReposts  PostReposts[]
}

model PendingRegistration {
  id           Int       @id @default(autoincrement())
  email        String
  hashed_token String    @unique
  verified_at  DateTime?
  expires_at   DateTime

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@index([email])
}

model Post {
  id              Int      @id @default(autoincrement())
  title           String
  sub_title       String
  slug            String   @unique
  thumbnail_image String?
  json_content    Json
  html_content    String   @db.Text
  published       Boolean? @default(false)
  author          User?    @relation(fields: [authorId], references: [id])
  authorId        String?

  tags         Tag[]
  postComments PostComments[]
  likes        PostLikes[]
  reposts      PostReposts[]

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
}

model Tag {
  id   String @id @default(uuid())
  name String @unique

  posts Post[]

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
}

model PostComments {
  id      String @id @default(uuid())
  content String @db.VarChar(200)

  user    User   @relation(fields: [user_id], references: [id])
  user_id String

  post    Post @relation(fields: [post_id], references: [id])
  post_id Int

  replyToComment      PostComments? @relation("CommentReplies", fields: [reply_to_comment_id], references: [id], onDelete: Cascade)
  reply_to_comment_id String?

  replies PostComments[] @relation("CommentReplies")

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@index([post_id])
  @@index([reply_to_comment_id])
}

model PostLikes {
  id Int @id @default(autoincrement())

  post    Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id Int

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  created_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@index([post_id])
  @@index([user_id])
}

model PostReposts {
  id Int @id @default(autoincrement())

  post    Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id Int

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  created_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@index([post_id])
  @@index([user_id])
}
