// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  password     String
  slug         String  @unique
  full_name    String? @db.VarChar(50)
  avatar       String?
  introduction String? @db.VarChar(200)
  is_active    Boolean @default(false)

  facebook_link String?
  x_link        String?
  youtube_link  String?
  linkedin_link String?
  website_link  String?

  background_image String?

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  posts           Post[]
  postComments    PostComments[]
  postLikes       PostLikes[]
  postReposts     PostReposts[]
  postCollections PostCollections[]
  savedPosts      UserSavedPosts[]
  postHighlights  PostHighlight[]

  userFollowers  UserFollow[] @relation("UserFollowers")
  userFollowings UserFollow[] @relation("UserFollowings")
  followedTags   TagFollow[]

  readingHistories UserReadingHistory[]

  pendingResetPasswordRequests PendingResetPasswordRequest[]
}

model PendingRegistration {
  id           Int       @id @default(autoincrement())
  email        String
  hashed_token String    @unique
  verified_at  DateTime?
  expires_at   DateTime

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@index([email])
}

model PendingResetPasswordRequest {
  id Int @id @default(autoincrement())

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  hashed_token String @unique

  used_at    DateTime?
  expires_at DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@index([expires_at])
}

model Post {
  id              Int      @id @default(autoincrement())
  title           String
  sub_title       String
  slug            String   @unique
  thumbnail_image String?
  json_content    Json
  html_content    String   @db.Text
  published       Boolean? @default(false)
  author          User?    @relation(fields: [authorId], references: [id])
  authorId        String?

  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  tags                Tag[]
  postComments        PostComments[]
  likes               PostLikes[]
  reposts             PostReposts[]
  postCollectionItems PostCollectionItems[]
  postStatistics      PostStatistics?
  postMetricDailies   PostMetricDaily[]
  savedByUsers        UserSavedPosts[]
  readedByUsers       UserReadingHistory[]
  highlights          PostHighlight[]

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
}

model Tag {
  id   String  @id @default(uuid())
  name String  @unique
  slug String? @unique

  posts Post[]

  created_at DateTime    @default(now())
  updated_at DateTime?   @updatedAt
  followers  TagFollow[]

  @@index([name])
  @@index([slug])
}

model PostComments {
  id      String @id @default(uuid())
  content String @db.VarChar(200)

  user    User   @relation(fields: [user_id], references: [id])
  user_id String

  post    Post @relation(fields: [post_id], references: [id])
  post_id Int

  replyToComment      PostComments? @relation("CommentReplies", fields: [reply_to_comment_id], references: [id], onDelete: Cascade)
  reply_to_comment_id String?

  replies PostComments[] @relation("CommentReplies")

  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@index([post_id])
  @@index([reply_to_comment_id])
}

model PostLikes {
  id Int @id @default(autoincrement())

  post    Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id Int

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  created_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@index([post_id])
  @@index([user_id])
}

model PostReposts {
  id Int @id @default(autoincrement())

  post    Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id Int

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  created_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@index([post_id])
  @@index([user_id])
}

model UserSavedPosts {
  id Int @id @default(autoincrement())

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  post    Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id Int

  created_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@index([user_id])
  @@index([post_id])
}

model PostCollections {
  id              String  @id @default(uuid())
  name            String
  slug            String  @unique
  description     String  @db.VarChar(200)
  thumbnail_image String?

  creator    User?   @relation(fields: [creator_id], references: [id])
  creator_id String?

  created_at          DateTime              @default(now())
  updated_at          DateTime?             @updatedAt
  postCollectionItems PostCollectionItems[]
}

model PostCollectionItems {
  id Int @id @default(autoincrement())

  post    Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id Int

  collection    PostCollections @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  collection_id String

  created_at DateTime @default(now())

  @@unique([post_id, collection_id])
  @@index([post_id])
  @@index([collection_id])
}

model PostStatistics {
  id Int @id @default(autoincrement())

  views_count    Int @default(0)
  reposts_count  Int @default(0)
  likes_count    Int @default(0)
  comments_count Int @default(0)

  post    Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id Int  @unique

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@index([post_id])
}

model PostMetricDaily {
  id Int @id @default(autoincrement())

  post    Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id Int

  date DateTime

  views_count    Int @default(0)
  likes_count    Int @default(0)
  reposts_count  Int @default(0)
  comments_count Int @default(0)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@unique([post_id, date])
  @@index([date])
  @@index([post_id, date])
}

model PostDailyUserInteraction {
  id Int @id @default(autoincrement())

  post_id Int
  user_id String
  date    DateTime

  liked    Boolean @default(false)
  reposted Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([post_id, user_id, date])
}

model PostViewLog {
  id Int @id @default(autoincrement())

  post_id    Int
  ip_address String
  user_agent String?
  bucket     DateTime

  viewed_at DateTime @default(now())

  @@unique([post_id, ip_address, user_agent, bucket])
}

model UserFollow {
  id Int @id @default(autoincrement())

  follower    User   @relation("UserFollowers", fields: [follower_id], references: [id], onDelete: Cascade)
  follower_id String

  following    User   @relation("UserFollowings", fields: [following_id], references: [id], onDelete: Cascade)
  following_id String

  created_at DateTime @default(now())

  @@unique([follower_id, following_id])
}

model TagFollow {
  id Int @id @default(autoincrement())

  tag    Tag    @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  tag_id String

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  is_email_notify Boolean @default(false)

  created_at DateTime @default(now())

  @@unique([tag_id, user_id])
  @@index([user_id])
  @@index([tag_id])
}

model UserReadingHistory {
  id Int @id @default(autoincrement())

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  post    Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id Int

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  @@unique([user_id, post_id])
  @@index([user_id])
  @@index([post_id])
}

model PostHighlight {
  id String @id @default(uuid())

  text  String  @db.Text
  note  String? @db.Text
  rects Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  post    Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id Int

  @@index([user_id])
  @@index([post_id])
  @@index([user_id, post_id])
}
